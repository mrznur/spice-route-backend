# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/feedback
DB_USER=feedback
DB_PASSWORD=feedback

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate a strong random value for production.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Access token lifetime in minutes
JWT_ACCESS_MINUTES=15
# Refresh token lifetime in days
JWT_REFRESH_DAYS=7

# ─── Super Admin (auto-created on first startup if no SUPER_ADMIN exists) ────
SUPERADMIN_EMAIL=admin@spiceroute.local
SUPERADMIN_PASSWORD=ChangeMe123!

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ─── QR Code base URL ────────────────────────────────────────────────────────
# The frontend URL that QR codes point to: {PUBLIC_BASE_URL}/f/{qrToken}
PUBLIC_BASE_URL=http://localhost:3000
